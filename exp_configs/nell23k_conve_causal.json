{
  "_comment": "Causal-HoGRN for NELL23K with ConvE scorer",
  "_description": "A+C + 高学习率：Clamp + 均衡损失 + causal_lr=0.1",
  "_design": "因果模块学习率100倍，解决梯度路径长导致信号衰减",
  "data": "NELL23K",
  "score_func": "conve",
  "batch": 256,
  "init_dim": 100,
  "gcn_dim": 100,
  "embed_dim": 100,
  "gcn_layer": 1,
  "gcn_drop": 0.1,
  "hid_drop": 0.3,
  "rel_reason": true,
  "pre_reason": true,
  "rel_mask": 0.1,
  "chan_drop": 0.1,
  "rel_norm": true,
  "use_causal": true,
  "causal_alpha": 1.0,
  "causal_gamma": 0.1,
  "causal_margin": 0.0,
  "causal_base": 0.3,
  "causal_scale": 0.7,
  "causal_hidden": 100,
  "causal_warmup": 5,
  "causal_lr": 0.1
}
