{
  "_comment": "Causal-HoGRN for NELL23K with ConvE scorer",
  "_description": "Gumbel-Softmax 边级别随机干预 + 目标稀疏率惩罚",
  "_design": "可微的边级别干预，目标稀疏率防止分数崩溃，主损失驱动边分化",
  "data": "NELL23K",
  "score_func": "conve",
  "batch": 256,
  "init_dim": 100,
  "gcn_dim": 100,
  "embed_dim": 100,
  "gcn_layer": 1,
  "gcn_drop": 0.1,
  "hid_drop": 0.3,
  "rel_reason": true,
  "pre_reason": true,
  "rel_mask": 0.1,
  "chan_drop": 0.1,
  "rel_norm": true,
  "use_causal": true,
  "causal_sparse": 0.001,
  "causal_target": 0.3,
  "causal_base": 0.3,
  "causal_scale": 0.7,
  "causal_hidden": 100,
  "causal_warmup": 30,
  "causal_temp_init": 1.0,
  "causal_temp_min": 0.1,
  "causal_temp_anneal": 0.005,
  "causal_lr": 0.01
}
